{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "raw",
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "bold_blue"
        },
        "width": 64,
        "position": "top"
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "blue",
            "title": "blue"
        }
    },
    "modules": [
        "Title",
        "Separator",
        {
            "type": "OS",
            "key": "OS"
        },
        {
            "type": "Host",
            "key": "Host"
        },
        {
            "type": "Kernel",
            "key": "Kernel"
        },
        {
            "type": "Uptime",
            "key": "Uptime"
        },
        {
            "type": "Processes",
            "key": "Processes"
        },
        "Separator",
        {
            "type": "CPU",
            "key": "CPU"
        },
        {
            "type": "CPUCache",
            "key": "Cache"
        },
        {
            "type": "GPU",
            "key": "GPU"
        },
        {
            "type": "Memory",
            "key": "RAM"
        },
        {
            "type": "Swap",
            "key": "Swap"
        },
        "Separator",
        {
            "type": "Disk",
            "key": "Disk"
        },
        {
            "type": "PhysicalDisk",
            "key": "Physical"
        },
        "Separator",
        {
            "type": "Display",
            "key": "Display"
        },
        {
            "type": "Sound",
            "key": "Sound"
        },
        "Separator",
        {
            "type": "LocalIP",
            "key": "Local IP"
        },
        {
            "type": "Bluetooth",
            "key": "Bluetooth"
        },
        "Separator",
        {
            "type": "Terminal",
            "key": "Term"
        },
        {
            "type": "TerminalFont",
            "key": "Font"
        },
        {
            "type": "Shell",
            "key": "Shell"
        },
        {
            "type": "Packages",
            "key": "Packages"
        },
        "Separator",
        "Colors"
    ]
}